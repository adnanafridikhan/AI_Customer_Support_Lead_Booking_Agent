      "id": "755c7001-8f76-46e8-9af3-1fe640330570",
      "name": "Get Booked Times",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.4,
      "position": [
        220,
        0
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "REPLACE_GOOGLE_CALENDAR",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Which 30-minute times are still free on the chosen date?\nconst TZ = 'Asia/Dubai';\nconst date = $('Website Lead Form').first().json.meeting_date;          // e.g. 2026-12-16\nconst fb = $json.calendars || {};\nconst busy = ((fb.primary || Object.values(fb)[0] || {}).busy || [])\n  .map((b) => [DateTime.fromISO(b.start).toMillis(), DateTime.fromISO(b.end).toMillis()]);\nconst day = DateTime.fromISO(date, { zone: TZ });\nconst earliest = DateTime.now().setZone(TZ).plus({ minutes: 30 });    // no bookings in the next 30 min\nconst free = [];\nif (day.isValid && day.weekday <= 5) {                                 // Monday–Friday only\n  for (let m = 10 * 60; m + 30 <= 16 * 60; m += 30) {                  // 10:00 AM … 3:30 PM start times\n    const start = day.set({ hour: Math.floor(m / 60), minute: m % 60, second: 0, millisecond: 0 });\n    const a = start.toMillis(), b = start.plus({ minutes: 30 }).toMillis();\n    const taken = busy.some(([x, y]) => a < y && x < b);\n    if (!taken && start >= earliest) free.push(start.toFormat('h:mm a'));\n  }\n}\nreturn [{ json: { meeting_date: date, free_times: free, free_count: free.length,\n  date_text: day.isValid ? day.toFormat('cccc, d LLLL yyyy') : date, is_weekend: day.isValid && day.weekday > 5 } }];"
      },
      "id": "90c0d60e-4355-4bbf-9883-2b6ecaf10cab",

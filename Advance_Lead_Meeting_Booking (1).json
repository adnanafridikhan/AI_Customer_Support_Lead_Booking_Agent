              "id": "c0fc6b4e-01f2-47ba-865f-823510d41963",
              "leftValue": "={{ $json.free_count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },

{
  "name": "Basic Lead Form → Google Meet Booking",
  "nodes": [
    {
      "parameters": {
        "content": "## Basic Lead → Meeting Booking\n1. Customer fills the **website form** (Production URL of the form node).\n2. A **Google Calendar event with a Google Meet link** is created (30 min, Dubai time).\n3. **Customer** and **admin** get an email with the meeting details.\n\n**Setup:** select your Google Calendar credential in *Create Google Meet Event*, check the admin email in *Prepare Meeting*, then **Publish**.",
        "height": 300,
        "width": 460,
        "color": 4
      },
      "id": "13b5f907-7292-497f-b116-29e3fbf7f7c5",
      "name": "Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -360
      ]
    },
    {
      "parameters": {
        "formTitle": "Book a Meeting",
        "formDescription": "Tell us about your project and choose a time. Meetings are 30 minutes on Google Meet, Monday to Friday, 10:00 AM – 4:00 PM (Dubai time).",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Full Name",
              "fieldName": "full_name",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Email Address",
              "fieldName": "email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Phone Number",
              "fieldName": "phone",
              "fieldType": "text",
              "placeholder": "+971 50 123 4567",
              "requiredField": true
            },
            {
              "fieldLabel": "Company Name",
              "fieldName": "company",
              "fieldType": "text"
            },
            {
              "fieldLabel": "Service Interested In",
              "fieldName": "service",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "AI Automation"
                  },
                  {
                    "option": "n8n Workflow Development"
                  },
                  {
                    "option": "Mobile App Development"
                  },
                  {
                    "option": "Web Development"
                  },
                  {
                    "option": "Consulting"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Project Requirements / Message",
              "fieldName": "message",
              "fieldType": "textarea"
            },
            {
              "fieldLabel": "Preferred Meeting Date",
              "fieldName": "meeting_date",
              "fieldType": "date",
              "requiredField": true
            },
            {
              "fieldLabel": "Preferred Meeting Time (Dubai)",
              "fieldName": "meeting_time",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "10:00 AM"
                  },
                  {
                    "option": "10:30 AM"
                  },
                  {
                    "option": "11:00 AM"
                  },
                  {
                    "option": "11:30 AM"
                  },
                  {
                    "option": "12:00 PM"
                  },
                  {
                    "option": "12:30 PM"
                  },
                  {
                    "option": "1:00 PM"
                  },
                  {
                    "option": "1:30 PM"
                  },
                  {
                    "option": "2:00 PM"
                  },
                  {
                    "option": "2:30 PM"
                  },
                  {
                    "option": "3:00 PM"
                  },
                  {
                    "option": "3:30 PM"
                  }
                ]
              }
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Book Meeting",
          "path": "book-meeting",
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Thank you! Your meeting is booked. Please check your email for the Google Meet link."
            }
          }
        }
      },
      "id": "9bd82b93-32a9-4106-884a-943f348036c7",
      "name": "Website Lead Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        0
      ],
      "webhookId": "6be35fee-3cda-4bd6-b291-95fc579c1288"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "92c172a8-94a3-4f96-826a-b38758ead133",
              "name": "admin_email",
              "value": "adnanafridi16@gmail.com",
              "type": "string"
            },
            {
              "id": "40d0cd11-7278-4892-8cc5-4539e33d01aa",
              "name": "start",
              "value": "={{ DateTime.fromFormat($json.meeting_date + ' ' + $json.meeting_time, 'yyyy-MM-dd h:mm a', { zone: 'Asia/Dubai' }).toISO() }}",
              "type": "string"
            },
            {
              "id": "34881570-5b58-4d00-addd-ae78ecbd9cfb",
              "name": "end",
              "value": "={{ DateTime.fromFormat($json.meeting_date + ' ' + $json.meeting_time, 'yyyy-MM-dd h:mm a', { zone: 'Asia/Dubai' }).plus({ minutes: 30 }).toISO() }}",
              "type": "string"
            },
            {
              "id": "e5c680f9-fd73-455f-82e9-91a82e8b15be",
              "name": "date_text",
              "value": "={{ DateTime.fromFormat($json.meeting_date, 'yyyy-MM-dd').toFormat('cccc, d LLLL yyyy') }}",
              "type": "string"
            },
            {
              "id": "4d750ff8-e978-48c2-87ad-156c2d1e2663",
              "name": "time_text",
              "value": "={{ $json.meeting_time + ' – ' + DateTime.fromFormat($json.meeting_time, 'h:mm a').plus({ minutes: 30 }).toFormat('h:mm a') + ' (Dubai time)' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "8008f797-76cb-4bf3-baa3-def2732ef0d7",
      "name": "Prepare Meeting",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/calendar/v3/calendars/primary/events",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "conferenceDataVersion",
              "value": "1"
            },
            {
              "name": "sendUpdates",
              "value": "all"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ summary: 'Lead Discussion – ' + $('Website Lead Form').item.json.full_name, description: 'Phone: ' + $('Website Lead Form').item.json.phone + '\\nCompany: ' + ($('Website Lead Form').item.json.company || '-') + '\\nService: ' + ($('Website Lead Form').item.json.service || '-') + '\\n\\nRequirements:\\n' + ($('Website Lead Form').item.json.message || '-'), start: { dateTime: $json.start, timeZone: 'Asia/Dubai' }, end: { dateTime: $json.end, timeZone: 'Asia/Dubai' }, attendees: [ { email: $('Website Lead Form').item.json.email }, { email: $json.admin_email } ], conferenceData: { createRequest: { requestId: $execution.id + '-meet', conferenceSolutionKey: { type: 'hangoutsMeet' } } } }) }}",
        "options": {}
      },
      "id": "d77a8d36-7fcf-47fb-b54c-8d51de79a3d7",
      "name": "Create Google Meet Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        440,
        0
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "REPLACE_GOOGLE_CALENDAR",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('Website Lead Form').item.json.email }}",
        "subject": "Your Online Meeting Is Confirmed",
        "emailType": "html",
        "message": "=<p>Hi {{ $('Website Lead Form').item.json.full_name }},</p>\n<p>Thank you for contacting us. Your online meeting is confirmed:</p>\n<p><b>Date:</b> {{ $('Prepare Meeting').item.json.date_text }}<br><b>Time:</b> {{ $('Prepare Meeting').item.json.time_text }}<br><b>Duration:</b> 30 minutes<br><b>Google Meet:</b> <a href=\"{{ $json.hangoutLink }}\">{{ $json.hangoutLink }}</a></p>\n<p>A calendar invitation has also been sent to your email.</p>\n<p>Kind regards,<br>{{ $('Prepare Meeting').item.json.admin_email }}</p>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "d64cb49f-77ce-481f-8b12-b780952beb91",
      "name": "Email Customer",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "webhookId": "8b87b1a1-4280-4754-9c29-5512f4e2270c",
      "credentials": {
        "gmailOAuth2": {
          "id": "glaz70JjomVaZkTZ",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('Prepare Meeting').item.json.admin_email }}",
        "subject": "New Lead – Meeting Scheduled",
        "emailType": "text",
        "message": "=New lead – meeting scheduled\n\nName: {{ $('Website Lead Form').item.json.full_name }}\nEmail: {{ $('Website Lead Form').item.json.email }}\nPhone: {{ $('Website Lead Form').item.json.phone }}\nCompany: {{ $('Website Lead Form').item.json.company || '-' }}\nService: {{ $('Website Lead Form').item.json.service || '-' }}\nRequirements: {{ $('Website Lead Form').item.json.message || '-' }}\n\nDate: {{ $('Prepare Meeting').item.json.date_text }}\nTime: {{ $('Prepare Meeting').item.json.time_text }}\nGoogle Meet: {{ $('Create Google Meet Event').item.json.hangoutLink }}\nCalendar event: {{ $('Create Google Meet Event').item.json.htmlLink }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "729001a8-1ea4-4f75-b69a-e038afec9435",
      "name": "Email Admin",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ],
      "webhookId": "a5c1fb0a-6d8e-492f-9ff0-edc5844f3229",
      "credentials": {
        "gmailOAuth2": {
          "id": "glaz70JjomVaZkTZ",
          "name": "Gmail account"
        }
      }
    }
  ],
